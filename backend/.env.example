# NestJS HTTP port
PORT=4000

# Allowed browser origin (Next.js dev server)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection
DATABASE_URL=postgresql://scorehub:scorehub@localhost:5432/scorehub?schema=public

# Direct connection for Prisma CLI migrations and database backups.
# On Neon, set this to DATABASE_URL_UNPOOLED; locally use the direct DB URL.
DATABASE_URL_UNPOOLED=postgresql://scorehub:scorehub@localhost:5432/scorehub?schema=public
