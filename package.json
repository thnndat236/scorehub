{
  "name": "scorehub",
  "version": "1.0.0",
  "private": true,
  "description": "Score analytics platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @scorehub/backend --filter @scorehub/frontend dev",
    "dev:backend": "pnpm --filter @scorehub/backend dev",
    "dev:frontend": "pnpm --filter @scorehub/frontend dev",
    "build": "pnpm -r --filter @scorehub/backend --filter @scorehub/frontend build",
    "lint": "pnpm -r --filter @scorehub/backend --filter @scorehub/frontend lint",
    "typecheck": "pnpm -r --filter @scorehub/backend --filter @scorehub/frontend typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
